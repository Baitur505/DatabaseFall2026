SELECT * FROM employees;

SELECT first_name, last_name FROM employees;

SELECT first_name FROM employees WHERE e_id > 100 AND department = 'TV';

SELECT first_name FROM employees WHERE first_name LIKE 'Wil%';

SELECT last_name FROM employees WHERE last_name LIKE '%leck';

SELECT department FROM employees WHERE department ~ '^[AT}';

SELECT first_name, e_id,
  CASE
	WHEN e_id BETWEEN 100 AND 200 THEN 'Bruce'
	ELSE 'Matt'
FROM employees;
