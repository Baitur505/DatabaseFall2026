SELECT c.client_name, c.email, o.order_date, o.total_amount FROM clients c 
INNER JOIN orders o ON c.client_id = o.client_id;

SELECT c.client_name, c.email, o.order_date, o.total_amount FROM clients c 
LEFT JOIN orders o ON c.client_id = o.client_id;

SELECT c.client_name, c.email, o.order_date, o.total_amount FROM clients c 
RIGHT JOIN orders o ON c.client_id = o.client_id;

SELECT c.client_name, c.email, o.order_date, o.total_amount FROM clients c 
FULL OUTER JOIN orders o ON c.client_id = o.client_id;

SELECT c.client_name, p.product_name FROM clients c 
CROSS JOIN products p;

SELECT c.client_name, o.order_date, oi.quantity, p.product_name, p.price FROM clients c 
INNER JOIN orders o ON c.client_id = o.client_id 
INNER JOIN order_items oi ON o.order_id = oi.order_id 
INNER JOIN products p ON oi.product_id = p.product_id;

SELECT e1.staff_name AS staff_member, e2.staff_name AS manager FROM staff e1 
LEFT JOIN staff e2 ON e1.manager_id = e2.staff_id;

SELECT c.client_name, o.order_date, o.total_amount FROM clients c 
INNER JOIN orders o ON c.client_id = o.client_id 
WHERE o.order_date >= '2024-01-01' AND o.total_amount > 100;

SELECT u.username, up.first_name, up.last_name, up.phone FROM users u 
LEFT JOIN user_profiles up ON u.user_id = up.user_id;

SELECT a.author_name, b.title, b.publication_year FROM authors a 
INNER JOIN books b ON a.author_id = b.author_id 
ORDER BY a.author_name, b.publication_year;

SELECT s.student_name, c.course_name, e.enrollment_date, e.grade FROM students s 
INNER JOIN enrollments e ON s.student_id = e.student_id 
INNER JOIN courses c ON e.course_id = c.course_id 
WHERE e.grade IS NOT NULL 
ORDER BY s.student_name, c.course_name;

CREATE INDEX idx_orders_client_id ON orders(client_id);
CREATE INDEX idx_order_items_order_id ON order_items(order_id);
CREATE INDEX idx_order_items_product_id ON order_items(product_id);

